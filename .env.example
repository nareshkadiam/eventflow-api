# ── Server ──────────────────────────────────────────────────────────────
# Port the HTTP server listens on (AWS App Runner / ECS will set this)
PORT=8080
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (no wildcard)
CORS_ORIGINS=http://localhost:3000

# Shared secret protecting POST /internal/process-jobs (set by EventBridge Scheduler)
INTERNAL_JOBS_SECRET=replace-with-a-long-random-secret

# ── Supabase ─────────────────────────────────────────────────────────────
# Connection string via Supabase's connection pooler (Supavisor, port 6543) — NOT the direct connection.
# Transaction/session pooler recommended for serverless-ish backends. Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.example:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://example.supabase.co

# Supabase JWT secret (used to verify auth JWTs server-side; from Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# Supabase service_role key (server-side only; never expose to clients). Used for admin operations via Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Anon key (used to proxy signUp/signInWithPassword through Supabase Auth API)
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# ── SMTP (nodemailer) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="EventFlow <no-reply@example.com>"

# ── Job queue ────────────────────────────────────────────────────────────
# Max concurrent connections in the pg Pool. Keep low (5-10) because cloud tasks scale out.
PGBOUNCER_MAX=10